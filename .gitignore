__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
knowledge/loop.log
examples/*.pdf
examples/*.png

# Page renders are regenerable intermediates; the tracked value is the STRUCTURE
# (layout.json / figures_meta.json / content.md) and the figure crops.
corpus/extracted/*/pages/

corpus/raw/
corpus/pages_for_vlm/
_qc_negative/
qc_artifacts/
corpus/qc_r3/
corpus/_r3_*
corpus/_vlm_*
corpus/_insp*
corpus/_qc_*

# Raw third-party datasets are CACHE, not source: 1.57 GB of dataverse CSVs defeated the
# 80 MB tracked budget in one scheduled commit (see SeedsREADME.md).
Seeds/**/dataverse_files/*.csv
Seeds/**/dataverse_files/*.pbz2


# Seed reproduction: the edgelist aggregation is a regenerable intermediate, not an artefact.
corpus/seed/cache/


# The report DOCX is regenerable from scripts/build_capability_report.py; the PDF is the deliverable.
reports/*.docx


# Default output of figpipe/skills.py when no out_stem is given.
templates/skills/


# Benchmark references are CC BY-NC: local evaluation cache only, never committed.
corpus/e2e/cache/
corpus/e2e/images/
corpus/e2e/tmp/


# Reports are HTML only; the old DOCX/PDF formats are not produced.
reports/*.pdf
reports/*.docx


# The official scorer is vendored for LOCAL evaluation only (CC BY-NC 4.0); it is not packaged.
# See third_party/plottwin_scorer/NOTICE.md
corpus/e2e/official_scorer/


# Benchmark run logs are scratch.
corpus/e2e/*.log


# Worked-example artefacts are regenerated by the example itself.
examples/output/


# The measurement lock is transient state, never committed.
knowledge/.measurement.lock


# Mutation-loop probe renders: regenerable intermediates, like templates/skills/.
templates/mutation/

# Loop liveness + watchdog state: runtime facts, not source.
knowledge/loop.heartbeat
knowledge/loop.log
knowledge/watchdog.log
knowledge/.watchdog.last-ok


# Watchdog single-instance lock: runtime state, never committed.
knowledge/.watchdog-loop.lock
