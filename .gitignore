__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
knowledge/loop.log
examples/*.pdf
examples/*.png

# Page renders are regenerable intermediates; the tracked value is the STRUCTURE
# (layout.json / figures_meta.json / content.md) and the figure crops.
corpus/extracted/*/pages/

corpus/raw/
corpus/pages_for_vlm/
_qc_negative/
qc_artifacts/
corpus/qc_r3/
corpus/_r3_*
corpus/_vlm_*
corpus/_insp*
corpus/_qc_*

# Raw third-party datasets are CACHE, not source: 1.57 GB of dataverse CSVs defeated the
# 80 MB tracked budget in one scheduled commit (see SeedsREADME.md).
Seeds/**/dataverse_files/*.csv
Seeds/**/dataverse_files/*.pbz2


# Seed reproduction: the edgelist aggregation is a regenerable intermediate, not an artefact.
corpus/seed/cache/


# The report DOCX is regenerable from scripts/build_capability_report.py; the PDF is the deliverable.
reports/*.docx


# Default output of figpipe/skills.py when no out_stem is given.
templates/skills/


# Benchmark references are CC BY-NC: local evaluation cache only, never committed.
corpus/e2e/cache/
corpus/e2e/images/
corpus/e2e/tmp/

