{
  "name": "paper-figure-validator",
  "version": "1.0.0",
  "description": "Validate academic paper figures for journal submission: DPI, format, captions, color policy, reproducibility, and more.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npx tsx tests/index.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "paper",
    "figure",
    "validation",
    "academic",
    "latex",
    "journal",
    "submission",
    "dpi",
    "reproducibility"
  ],
  "author": "Guilherme Silveira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermesilveira/paper-figure-validator.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
