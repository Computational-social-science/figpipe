{
  "experiment": "style-metric discrimination on local published Nature figures",
  "what_this_measures": "Whether figpipe's own style distance ranks a style transferred from the MATCHED reference closer to that reference than a style transferred from a MISMATCHED one. This tests ORDERING, not expert preference: it can refute a blind or inverted metric, it cannot establish that the closer figure is the better figure.",
  "not_human_validation": "No human judgement was collected. This is a deterministic proxy that removes the 'the metric was never tested at all' gap; it does not replace a reader study.",
  "corpus": {
    "source": "corpus/extracted (local published Nature figures, vector PDF regions)",
    "n_candidates_scanned": 106,
    "style_floors": {
      "min_width_pt": 90.0,
      "min_height_pt": 60.0,
      "min_text_spans": 8,
      "min_size_tiers": 2,
      "min_colours": 2
    },
    "skipped": {
      "below_style_floors": 57
    }
  },
  "design": {
    "n_pairs": 30,
    "seed": 20261021,
    "contrast_requested": "same",
    "A": "style transferred from a MISMATCHED published figure",
    "B": "style transferred from the MATCHED reference itself",
    "candidate_data": "identical synthetic panel for both candidates",
    "distance": "figpipe.styleprofile.compare (the metric under test)",
    "mismatch_contrast": {
      "different_paper": 0,
      "same_paper": 30
    },
    "contrast_note": "cross-paper mismatch is the EASY condition: two unrelated papers differ in palette, typography and layout at once. A same-paper mismatch (another figure in the same paper) shares a house style and is the condition a style metric is actually for. Both are reported; neither substitutes for the other.",
    "arms": {
      "headline": "same_paper",
      "why": "the same-paper mismatch holds the journal's house style constant, so it asks whether the metric separates a faithful transfer from a sibling figure's style -- the question the metric exists to answer"
    }
  },
  "discrimination_accuracy": 0.9333,
  "n_correct": 28,
  "n_pairs": 30,
  "binomial_ci_95": [
    0.7868,
    0.9815
  ],
  "chance_level": 0.5,
  "p_value_vs_chance": 4.33996319770813e-07,
  "p_value_text": "4.34e-07",
  "mean_margin": 0.1206,
  "median_margin": 0.1075,
  "verdict": "SUPPORTED at this contrast: the style distance discriminates a matched transfer from a mismatched one at above-chance accuracy, with a 95 % interval that excludes chance. CONCENTRATION: withholding `aspect` alone drops accuracy to 0.77 (delta -0.17), so most of the discrimination is that one component.",
  "negative_control": {
    "what": "the same arithmetic applied to an INVERTED ranking (distance negated)",
    "accuracy": 0.0333,
    "n_correct": 1,
    "n_pairs": 30,
    "n_ties": 1,
    "binomial_ci_95": [
      0.0059,
      0.1667
    ],
    "passes": true,
    "note": "A harness that reports the same number for the inverted ranking is measuring nothing. This control is asserted by the test suite. Ties are counted in neither direction, so forward + inverted + ties = n."
  },
  "official_scorer": {
    "scorer": "plottwin_scorer deviation-defect-v1 (vendored, unmodified)",
    "channel": "code_deviation (35 % of the official combined score)",
    "n_pairs_scored": 30,
    "n_pairs_unavailable": 0,
    "n_agree": 26,
    "n_disagree": 1,
    "n_tie": 3,
    "n_decisive": 27,
    "agreement_rate": 0.963,
    "agreement_rate_including_ties": 0.8667,
    "agreement_ci": [
      0.8172,
      0.9934
    ],
    "official_correct": 26,
    "official_accuracy": 0.963,
    "note": "The official channel is a DEVIATION score (100 = the candidate's style calls match the reference's). It is run on code emitted from the RENDERED candidates' own measured profiles, so it describes what was rendered. Agreement is counted only where the channel is available for BOTH candidates, and the rate is over decisive comparisons: a pair where the official channel scores both candidates identically is a tie, not a disagreement."
  },
