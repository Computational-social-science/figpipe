{
  "experiment": "style-metric discrimination on local published Nature figures",
  "what_this_measures": "Whether figpipe's own style distance ranks a style transferred from the MATCHED reference closer to that reference than a style transferred from a MISMATCHED one. This tests ORDERING, not expert preference: it can refute a blind or inverted metric, it cannot establish that the closer figure is the better figure.",
  "not_human_validation": "No human judgement was collected. This is a deterministic proxy that removes the 'the metric was never tested at all' gap; it does not replace a reader study.",
  "corpus": {
    "source": "corpus/extracted (local published Nature figures, vector PDF regions)",
    "n_candidates_scanned": 106,
    "style_floors": {
      "min_width_pt": 90.0,
      "min_height_pt": 60.0,
      "min_text_spans": 8,
      "min_size_tiers": 2,
      "min_colours": 2
    },
    "skipped": {
      "below_style_floors": 57
    }
  },
  "design": {
    "n_pairs": 30,
    "seed": 20261019,
    "contrast_requested": "same",
    "A": "style transferred from a MISMATCHED published figure",
    "B": "style transferred from the MATCHED reference itself",
    "candidate_data": "identical synthetic panel for both candidates",
    "distance": "figpipe.styleprofile.compare (the metric under test)",
    "mismatch_contrast": {
      "different_paper": 0,
      "same_paper": 30
    },
    "contrast_note": "cross-paper mismatch is the EASY condition: two unrelated papers differ in palette, typography and layout at once. A same-paper mismatch (another figure in the same paper) shares a house style and is the condition a style metric is actually for. Both are reported; neither substitutes for the other."
  },
  "discrimination_accuracy": 0.8,
  "n_correct": 24,
  "n_pairs": 30,
  "binomial_ci_95": [
    0.6269,
    0.9049
  ],
  "chance_level": 0.5,
  "p_value_vs_chance": 0.000715453177690506,
  "p_value_text": "7.15e-04",
  "mean_margin": 0.0713,
  "median_margin": 0.0495,
  "verdict": "SUPPORTED at this contrast: the style distance discriminates a matched transfer from a mismatched one at above-chance accuracy, with a 95 % interval that excludes chance. CONCENTRATION: withholding `palette` alone drops accuracy to 0.63 (delta -0.17), so most of the discrimination is that one component.",
  "negative_control": {
    "what": "the same arithmetic applied to an INVERTED ranking (distance negated)",
    "accuracy": 0.0667,
    "n_correct": 2,
    "n_pairs": 30,
    "n_ties": 4,
    "binomial_ci_95": [
      0.0185,
      0.2132
    ],
    "passes": true,
    "note": "A harness that reports the same number for the inverted ranking is measuring nothing. This control is asserted by the test suite. Ties are counted in neither direction, so forward + inverted + ties = n."
  },
  "official_scorer": {
    "scorer": "plottwin_scorer deviation-defect-v1 (vendored, unmodified)",
    "channel": "code_deviation (35 % of the official combined score)",
