{
  "about": "Global skill floor + classic operators + named recipes for scientific figures.",
  "global_verify": [
    "verify.audit",
    "verify.collisions"
  ],
  "operators": [
    {
      "name": "layout.plate",
      "kind": "build",
      "doc": "Set the plate geometry: column width, height, sharing, letters, margins."
    },
    {
      "name": "encode.trend",
      "kind": "build",
      "doc": "Encode a trend panel: points, optional interval, fit, reference line."
    },
    {
      "name": "encode.ranked",
      "kind": "build",
      "doc": "Encode a ranked composition: bars sorted by value, number printed on each bar."
    },
    {
      "name": "encode.density",
      "kind": "build",
      "doc": "Encode a dense relationship as a hexbin with optional marginals and colour bar."
    },
    {
      "name": "encode.matrix",
      "kind": "build",
      "doc": "Encode a numeric matrix (all numeric columns, or a comma list) as signed tiles."
    },
    {
      "name": "encode.box",
      "kind": "build",
      "doc": "Encode a distribution comparison as box plots."
    },
    {
      "name": "encode.bars",
      "kind": "build",
      "doc": "Encode parallel measures per category as grouped bars."
    },
    {
      "name": "encode.scatter",
      "kind": "build",
      "doc": "Encode a relationship as a scatter with a fit and r."
    },
    {
      "name": "encode.hist",
      "kind": "build",
      "doc": "Encode the distribution of one measured column (optionally split by a category)."
    },
    {
      "name": "encode.dual",
      "kind": "build",
      "doc": "Encode two series on one x with separate left/right y axes (both labelled)."
    },
    {
      "name": "axis.log",
      "kind": "build",
      "doc": "Set log scale for x, y, or both; encoders read it from the context."
    },
    {
      "name": "layout.facets",
      "kind": "build",
      "doc": "Repeat one classic encoding for each level of a facet column."
    },
    {
      "name": "encode.error_bars",
      "kind": "build",
      "doc": "Encode a few entities compared with their uncertainty, as bars + error bars."
    },
    {
      "name": "layout.split_panels",
      "kind": "build",
      "doc": "Build one panel per level of a grouping column from a long table."
    },
    {
      "name": "encode.polar",
      "kind": "build",
      "doc": "Encode a radial profile: one value per angle (category or degrees)."
    },
    {
      "name": "style.profile",
      "kind": "build",
      "doc": "Apply a measured reference style: rcParams, palette, and its aspect-derived height."
    },
    {
      "name": "verify.audit",
      "kind": "verify",
      "doc": "Compliance audit on the rendered PDF (fonts, width, height, embedded fonts)."
    },
    {
      "name": "verify.collisions",
      "kind": "verify",
      "doc": "Glyph-level text collisions (rotated tick labels are not false positives)."
    },
    {
      "name": "verify.statistics",
      "kind": "verify",
      "doc": "Reconcile reproduced statistics against the published values."
    }
  ],
