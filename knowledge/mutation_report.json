  "proposed": [
    {
      "id": "split-max-bars-24",
      "operator": "layout.split_panels",
      "parameter": "max_bars",
      "baseline_value": 12,
      "value": 24,
      "rationale": "LEARNINGS ##46 set the category budget at 12 because 20 year-bars produced 19 collisions. Relaxing it to 24 lets that defect back in; the probe measures whether the task set still sees it.",
      "skill": "composite_groups"
    },
    {
      "id": "split-max-bars-13",
      "operator": "layout.split_panels",
      "parameter": "max_bars",
      "baseline_value": 12,
      "value": 13,
      "rationale": "an off-by-one relaxation: if 12 were too tight, one extra category would recover a refusal at no legibility cost. The probe asks whether any task can tell the two budgets apart.",
      "skill": "composite_groups"
    },
    {
      "id": "matrix-max-rows-41",
      "operator": "encode.matrix",
      "parameter": "max_rows",
      "baseline_value": 40,
      "value": 41,
      "rationale": "the row budget is one row tighter than the measured collision boundary: 41 unpivotable rows render with 0 collisions and 42 produce 41. If that holds on the task set, the budget refuses a table it could draw.",
      "skill": "matrix_plate"
    },
    {
      "id": "matrix-max-rows-42",
      "operator": "encode.matrix",
      "parameter": "max_rows",
      "baseline_value": 40,
      "value": 42,
      "rationale": "one row past the measured boundary: it admits the 48-row table, whose tick labels collide. The expected verdict is a rejection, so this is the negative control for 'any relaxation is a gain'.",
      "skill": "matrix_plate"
    },
    {
      "id": "matrix-max-rows-60",
      "operator": "encode.matrix",
      "parameter": "max_rows",
      "baseline_value": 40,
      "value": 60,
      "rationale": "LEARNINGS ##47 records the row budget as a refusal that was nearly a regression. Relaxing it to 60 re-admits the 48-row table and tests whether the collisions it was protecting against are still there.",
      "skill": "matrix_plate"
    },
